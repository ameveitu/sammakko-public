{
  "name": "sammakko-golden-slice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "slice:rebuild": "tsx tools/rebuild-slice.ts",
    "slice:check": "tsx tools/rebuild-slice.ts --check",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "validate:release": "tsx tools/validate.ts --release",
    "build": "tsx tools/compile.ts && tsc --noEmit && vite build && tsx tools/seal-build.ts",
    "test:e2e": "playwright test",
    "check": "npm run slice:check && npm run lint && npm run typecheck && npm test && npm run validate && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
